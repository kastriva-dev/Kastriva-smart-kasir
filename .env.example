# === Autentikasi halaman internal (/ dan /kasir) ===
# Wajib. Secret penanda tangan cookie session, minimal 32 karakter.
# Buat dengan: npm run auth:hash -- --secret
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Wajib. Hash password admin (scrypt), BUKAN password polos.
# Buat dengan: npm run auth:hash -- 'password-anda'
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...$...

# Opsional. Default: admin
ADMIN_USERNAME=admin

# Opsional. Masa berlaku session dalam jam (default 8, maksimum 720)
SESSION_TTL_HOURS=8

# Opsional. Kosongkan agar flag Secure pada cookie mengikuti protokol permintaan
# (perlu untuk instalasi lokal via HTTP). Set true untuk mewajibkan HTTPS.
AUTH_COOKIE_SECURE=

# === Backend Google Apps Script ===
# Wajib: URL deployment Google Apps Script (/exec)
GAS_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Wajib: harus sama dengan Script Property GAS_API_KEY di Apps Script.
# Tanpa ini Apps Script menolak semua request (fail-closed).
GAS_API_KEY=ganti-dengan-secret-acak-panjang

# Wajib untuk action tulis & baca data sensitif di /api/gas dan /api/orders.
# Dikirim lewat header x-admin-token atau Authorization: Bearer.
ADMIN_API_TOKEN=ganti-dengan-token-acak-panjang

# Opsional: timeout panggilan ke Apps Script dalam milidetik (default 15000)
GAS_TIMEOUT_MS=15000

# === Publik (ikut ke browser, jangan taruh secret di sini) ===
NEXT_PUBLIC_STORE_NAME=Kastriva Smart Kasir
NEXT_PUBLIC_STORE_ID=kastriva
NEXT_PUBLIC_CASHIER_WHATSAPP=628xxxxxxxxxx
NEXT_PUBLIC_CURRENCY=IDR
